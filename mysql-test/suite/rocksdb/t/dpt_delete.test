--source include/have_debug.inc
--source include/have_rocksdb.inc

--disable_query_log
# Range deletions fail with user defined timestamps.
call mtr.add_suppression("Failed to write range deletions with a delete persistence threshold");
--enable_query_log

CREATE TABLE t1 (
  a int PRIMARY KEY
) ENGINE=rocksdb DPT=10;

insert into t1 values (1), (2), (3);

delete from t1 WHERE a=1 WITH dpt=10;

select * from t1;

delete from t1 with dpt=5;

select * from t1;

drop table t1;